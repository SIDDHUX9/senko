{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/yahoo/(.*)",
      "destination": "https://query1.finance.yahoo.com/$1"
    },
    {
      "source": "/api/tradingview/(.*)",
      "destination": "https://scanner.tradingview.com/$1"
    }
  ]
}
